# RViz2 config for the Skate MoveIt demo — the MotionPlanning display over
# the live planning scene. Pick left_arm / right_arm / both_arms in the
# MotionPlanning frame, drag the goal marker, Plan / Plan & Execute. (In
# ROS 2 MotionPlanning is a *Display* — it brings its own dockable frame;
# a Panels entry for it is a ROS 1 leftover that fails to load.)
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Global Options:
    Fixed Frame: base_link2
    Background Color: 48; 48; 48
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Plane Cell Count: 10
      Color: 160; 160; 164
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Marker Scale: 0.3
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Enabled: true
      Move Group Namespace: ""
      Robot Description: robot_description
      Planning Scene Topic: monitored_planning_scene
      Scene Geometry:
        Scene Alpha: 0.9
      Scene Robot:
        Robot Alpha: 1.0
        Show Robot Visual: true
      Planning Request:
        Planning Group: left_arm
        Interactive Marker Size: 0.12
        Query Goal State: true
        Goal State Alpha: 0.4
        Query Start State: false
      Planned Path:
        Loop Animation: true
        Show Robot Visual: true
        Robot Alpha: 1
        State Display Time: 0.05 s
        Show Trail: false
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 2.0
      Pitch: 0.35
      Yaw: 0.9
      Focal Point:
        X: 0.0
        Y: 0.30
        Z: 0.20
Window Geometry:
  Height: 900
  Width: 1400
  MotionPlanning:
    collapsed: false
