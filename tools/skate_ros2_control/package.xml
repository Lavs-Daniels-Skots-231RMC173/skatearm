<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>skate_ros2_control</name>
  <version>0.1.0</version>
  <description>
    ros2_control hardware interface for the R.Botic Skate arms: a C++
    SystemInterface bridging the controller_manager to the skate_ros2 driver
    topics, plus JointTrajectoryController configs whose names match the
    skate_moveit_config controller list.
  </description>
  <maintainer email="porche121004@gmail.com">Daniels Skots Lavs</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>skate_ros2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
